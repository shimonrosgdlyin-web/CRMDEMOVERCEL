# Supabase — copy from your project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App's own public URL — used to build links that go into outgoing emails
# (currently: the invite-accept link in POST /api/organizations/invites).
# Server-only on purpose (not NEXT_PUBLIC_*, doesn't need client exposure).
# Pinning this avoids building that link from the request's Host header,
# which could be spoofed by whoever is calling that endpoint. Dev default:
APP_URL=http://localhost:3000

# Email (optional — for sending emails via the /api/email route)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
SMTP_FROM=your@email.com
